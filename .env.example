# Non-secret R1.2 application settings. Copy to .env for local development.
# Real credentials must use separately reviewed, read-only secret files.
DCWS_SEO_ENVIRONMENT=development
DCWS_SEO_LOG_LEVEL=INFO
DCWS_SEO_LOG_DESTINATION=stderr

# Required only when DCWS_SEO_LOG_DESTINATION=file. The parent directory must
# already exist and be writable by the future non-root application user.
# DCWS_SEO_LOG_FILE=/var/lib/dcwebstudio-seo/logs/application.jsonl
DCWS_SEO_LOG_MAX_BYTES=10485760
DCWS_SEO_LOG_BACKUP_COUNT=5

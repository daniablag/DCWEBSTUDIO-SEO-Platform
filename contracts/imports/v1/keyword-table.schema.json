{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dcwebstudio.com/seo/v1/keyword-table.schema.json",
  "title": "Keyword CSV import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "project_id", "locale_id", "market_id", "source", "file", "column_mapping", "rows", "validation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "batch_id": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/uuid"},
    "project_id": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/uuid"},
    "locale_id": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/uuid"},
    "market_id": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/uuid"},
    "content_target_id": {"type": ["string", "null"], "format": "uuid"},
    "source": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/source"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "media_type", "encoding", "delimiter", "has_header", "original_hash"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"},
        "media_type": {"const": "text/csv"},
        "encoding": {"const": "utf-8"},
        "delimiter": {"type": "string", "enum": [",", ";", "\\t"]},
        "has_header": {"const": true},
        "original_hash": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/sha256"}
      }
    },
    "column_mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["phrase", "locale_tag", "search_volume", "competition", "low_bid", "high_bid", "source", "target_url", "ignore"]
      },
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9 _.-]{1,80}$"}
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_number", "phrase", "locale_tag"],
        "properties": {
          "row_number": {"type": "integer", "minimum": 2},
          "phrase": {"type": "string", "minLength": 1, "maxLength": 500},
          "locale_tag": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/locale_tag"},
          "search_volume": {"type": ["integer", "null"], "minimum": 0},
          "competition": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "low_bid_minor_units": {"type": ["integer", "null"], "minimum": 0},
          "high_bid_minor_units": {"type": ["integer", "null"], "minimum": 0},
          "target_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https?://"}
        }
      }
    },
    "validation": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/validation_report"}
  }
}

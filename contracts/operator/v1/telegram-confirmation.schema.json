{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dcwebstudio.com/seo/v1/telegram-confirmation.schema.json",
  "title": "Expiring one-time Telegram confirmation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "confirmation_id", "command_id", "plan_id", "actor_ref", "token_hash", "issued_at", "expires_at", "state", "one_time", "confirmed_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "confirmation_id": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/uuid"},
    "command_id": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/uuid"},
    "plan_id": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/uuid"},
    "actor_ref": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/actor_ref"},
    "token_hash": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/sha256"},
    "issued_at": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "https://schemas.dcwebstudio.com/seo/v1/common.schema.json#/$defs/timestamp"},
    "state": {"type": "string", "enum": ["pending", "confirmed", "rejected", "expired", "consumed"]},
    "one_time": {"const": true},
    "confirmed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "confirmed"}}},
      "then": {"properties": {"confirmed_at": {"type": "string", "format": "date-time"}}}
    }
  ]
}
